{
  "name": "studyhub-server",
  "version": "1.0.0",
  "description": "StudyHub API server with PostgreSQL, JWT auth, and file upload",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-admin": "tsx src/db/createAdmin.ts",
    "seed:exam-prep": "tsx src/db/seedExamPrep.ts",
    "notes:apply": "tsx src/db/applyNotes.ts",
    "seed:exam-kits": "tsx src/db/seedExamKits.ts",
    "check:kit": "tsx src/db/checkKits.ts",
    "check:content": "node scripts/check-questions.cjs && node scripts/check-blueprints.cjs && tsx src/db/checkKits.ts"
  },
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "typescript": "^5.3.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "supertest": "^7.3.1",
    "tsx": "^4.6.0",
    "vitest": "^3.2.7"
  }
}

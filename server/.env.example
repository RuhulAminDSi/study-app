# Server
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/study_hub
UPLOAD_DIR=./uploads

# Auth: JWT_SECRET is required when NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=10
# Defaults to true in production (one proxy hop, e.g. Azure App Service)
TRUST_PROXY=

# Tests: optional; defaults to DATABASE_URL with the database renamed to study_hub_test
TEST_DATABASE_URL=
